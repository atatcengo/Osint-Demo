# Required — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/osint_demo

# Optional — Shodan API key (https://account.shodan.io/)
SHODAN_API_KEY=

# Optional — VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# Optional — urlscan.io API key (search works with small unauthenticated quotas)
URLSCAN_API_KEY=

# Optional — AbuseIPDB API key
ABUSEIPDB_API_KEY=

